{
  "name": "fleet-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Marichi Fleet ERP backend: configurable masters, authentication and an API test console",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --import ./tests/setup.ts tests/*.test.ts",
    "check": "npm run typecheck && npm run check:ui && npm test && npm run build && npm run build:web",
    "check:ui": "node web/scripts/check-ui.mjs",
    "seed": "tsx scripts/seed.ts",
    "rates:fetch": "node dist/jobs/fetchRates.js",
    "rates:fetch:dev": "tsx src/jobs/fetchRates.ts",
    "approvals:escalate": "node dist/jobs/escalate.js",
    "approvals:escalate:dev": "tsx src/jobs/escalate.ts",
    "kit": "tsx src/jobs/kit.ts",
    "trackers:poll": "node dist/jobs/pollTrackers.js",
    "build:web": "cd web && npm install --no-audit --no-fund && npm run build"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.7",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
