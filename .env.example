# Settings for running locally. For a company's copy on Google Cloud, see docs/deploy-gcp.md:
# deploy/new-company.sh sets the production values and keeps the secrets in Secret Manager.

# --- Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Public address of the API, used in password-reset and invitation links.
# Production refuses a local or plain-http address: set the public https:// address.
APP_URL=http://127.0.0.1:3000

# --- Data ---
MONGODB_URI=mongodb://127.0.0.1:27017/fleet_erp
# Optional. Without it, rate limits are kept in process memory (fine for one instance).
# REDIS_URL=redis://127.0.0.1:6379

# --- Sign-in ---
# Required in production: at least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=development-only-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# scrypt cost as a power of two (15 = 32,768).
PASSWORD_HASH_COST=15
# Development only: returns password-reset tokens in API responses. Refused in production.
EXPOSE_RESET_TOKEN=false
# Serves the API test console at /console/ and the public models reference. Password links open the web app.
CONSOLE_ENABLED=true
# Timers inside the server: moving up approvals that waited too long. Leave on for local runs and Docker
# Compose. Off where a scheduler runs the same work as a job (deploy/new-company.sh does this on Cloud Run).
IN_PROCESS_JOBS=true
# The company's first Owner. When set, that account is created at start-up and e-mailed a link to choose
# a password, and nobody can become the first Owner by signing up. Required in production.
# Later sign-ups are refused unless the company turns on self sign-up in its settings.
# OWNER_EMAIL=owner@example.com

# --- E-mail (SMTP credentials; required in production) ---
# SMTP_HOST=smtp.mandrillapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Marichi Fleet <no-reply@marichi.local>

# Exchange-rate feed (Masters → Exchange rates → Rate feed). The provider's API key; only needed when a
# provider other than "manual" is chosen. A scheduler runs `npm run rates:fetch` once a day.
# RATE_FEED_API_KEY=

# --- Deployment ---
# Browser origins allowed to call the API (comma-separated), e.g. the React app. Only needed when the
# frontend is served from another address. Scheme and host only, no path, no *; https:// in production.
# CORS_ORIGINS=http://localhost:5173
# The number of reverse proxies in front of the API (1 on Cloud Run or behind one load balancer), so rate
# limits see real client addresses. `true` is refused in production: it trusts any X-Forwarded-For.
TRUST_PROXY=false

# --- Uploaded documents ---
# local: a folder on the server (development, one VM). gcs: a Google Cloud Storage bucket (Cloud Run; its disk is wiped on restart).
FILE_STORAGE=local
FILE_STORAGE_DIR=data/files
# GCS_BUCKET=marichi-fleet-files
# On Google Cloud the credentials come from the service's account, which needs roles/storage.objectAdmin on the bucket.
# Largest upload, in MB.
UPLOAD_MAX_MB=15

# --- WhatsApp (Marichi Talks) ---
# Outbound messages are only logged until the Marichi Talks API details arrive.
# Shared secret for the inbound webhook (POST /api/v1/whatsapp/inbound, header X-Webhook-Secret). Off when unset.
# MARICHI_TALKS_WEBHOOK_SECRET=
# Lets signed-in staff act as a driver's WhatsApp from the app (the simulated phone).
# On by default outside production; off in production, where true is refused.
# DRIVER_PHONE_SIMULATOR=false
